---
interface Props {
  question: string;
  answer: string;
  appliesWhen?: string[];
  alternatives?: string[];
}
const { question, answer, appliesWhen = [], alternatives = [] } = Astro.props;
---
<section class="not-prose rounded-2xl border border-primary-200 dark:border-primary-900 bg-primary-50/60 dark:bg-stone-900 p-6" aria-labelledby="short-answer">
  <p id="short-answer" class="text-xs font-bold uppercase tracking-wider text-primary-700 dark:text-primary-300">Short answer</p>
  <p class="mt-1 text-sm font-semibold text-stone-700 dark:text-stone-300">{question}</p>
  <p class="mt-2 text-base leading-relaxed text-stone-800 dark:text-stone-100">{answer}</p>
  {(appliesWhen.length > 0 || alternatives.length > 0) && (
    <div class="mt-5 grid gap-5 sm:grid-cols-2 text-sm">
      {appliesWhen.length > 0 && (
        <div>
          <p class="font-semibold text-stone-800 dark:text-stone-200">This applies when</p>
          <ul class="mt-2 space-y-1.5 text-stone-600 dark:text-stone-400 list-disc pl-5">
            {appliesWhen.map((a) => <li>{a}</li>)}
          </ul>
        </div>
      )}
      {alternatives.length > 0 && (
        <div>
          <p class="font-semibold text-stone-800 dark:text-stone-200">Consider instead</p>
          <ul class="mt-2 space-y-1.5 text-stone-600 dark:text-stone-400 list-disc pl-5">
            {alternatives.map((a) => <li>{a}</li>)}
          </ul>
        </div>
      )}
    </div>
  )}
</section>
