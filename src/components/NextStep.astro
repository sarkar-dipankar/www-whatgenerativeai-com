---
import type { ChapterNextStep } from "../data/chapter-next-steps";
interface Props { step: ChapterNextStep }
const { step } = Astro.props;
const kindLabel = { guide: "Guide", tool: "Tool", offer: "Engagement" } as const;
---
<aside class="not-prose mt-12 rounded-xl border border-accent-200 dark:border-accent-700/40 bg-accent-50/60 dark:bg-stone-900 p-5" aria-label="Next decision">
  <p class="text-xs font-bold uppercase tracking-wider text-accent-700 dark:text-accent-400">Your next decision</p>
  <h2 class="mt-1 text-lg font-bold text-stone-900 dark:text-stone-50">{step.heading}</h2>
  <p class="mt-1 text-sm text-stone-600 dark:text-stone-400">{step.body}</p>
  <ul class="mt-3 flex flex-wrap gap-2">
    {step.links.map((l) => (
      <li>
        <a href={l.href} class="inline-flex items-center gap-2 rounded-lg border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-950 px-3 py-1.5 text-sm font-medium text-stone-800 dark:text-stone-100 hover:border-primary-500 hover:text-primary-700 transition">
          <span class="text-[10px] font-bold uppercase tracking-wider text-stone-500">{kindLabel[l.kind]}</span>
          {l.label}
        </a>
      </li>
    ))}
  </ul>
</aside>
