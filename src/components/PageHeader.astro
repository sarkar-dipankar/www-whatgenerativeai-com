---
// Compact gradient header for decision, tool and commercial pages.
interface Crumb { label: string; href?: string }
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  crumbs?: Crumb[];
}
const { eyebrow, title, lede, crumbs = [] } = Astro.props;
---
<section class="relative overflow-hidden border-b border-primary-900/20">
  <div class="absolute inset-0 -z-10 bg-gradient-to-br from-primary-900 via-primary-800 to-primary-700"></div>
  <div class="absolute inset-0 -z-10 opacity-[0.07]" style="background-image:radial-gradient(circle at 1px 1px, white 1px, transparent 0);background-size:24px 24px"></div>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    {crumbs.length > 0 && (
      <nav class="text-sm text-primary-200 mb-4" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white">Home</a>
        {crumbs.map((c) => (
          <>
            <span aria-hidden="true" class="mx-1">/</span>
            {c.href ? <a href={c.href} class="hover:text-white">{c.label}</a> : <span class="text-white/90">{c.label}</span>}
          </>
        ))}
      </nav>
    )}
    <div class="max-w-3xl">
      {eyebrow && <p class="text-xs font-semibold uppercase tracking-widest text-accent-300">{eyebrow}</p>}
      <h1 class="mt-2 text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white">{title}</h1>
      {lede && <p class="mt-4 text-lg text-primary-100/90 leading-relaxed">{lede}</p>}
      <slot />
    </div>
  </div>
</section>
