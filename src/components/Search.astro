---
import type { LanguageCode } from "../i18n";
import { DEFAULT_LANG, ui } from "../i18n";
interface Props { lang?: LanguageCode }
const { lang = DEFAULT_LANG } = Astro.props;
const t = (k: keyof typeof ui.en) => (ui as any)[lang]?.[k] ?? ui.en[k];
---
<div class="relative">
  <div id="pagefind-search" data-lang={lang} class="wgai-search"></div>
  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <style>
    .wgai-search :global(.pagefind-ui) {
      --pagefind-ui-primary: var(--color-brand-600, #1a66f2);
      --pagefind-ui-text: var(--color-ink-700, #334155);
      --pagefind-ui-background: #ffffff;
      --pagefind-ui-border: var(--color-ink-200, #e2e8f0);
      border-radius: 0.5rem;
    }
    .dark .wgai-search :global(.pagefind-ui) {
      --pagefind-ui-text: var(--color-ink-200, #e2e8f0);
      --pagefind-ui-background: var(--color-ink-900, #0f172a);
      --pagefind-ui-border: var(--color-ink-700, #334155);
    }
  </style>
</div>
<!-- pagefind-ui.js (generated at build time by astro-pagefind) is a classic script that
     sets window.PagefindUI; it has no ES module export, so load it with a script tag. -->
<script is:inline>
  (function () {
    if (!document.getElementById("pagefind-search")) return;
    var s = document.createElement("script");
    s.src = "/pagefind/pagefind-ui.js";
    s.onload = function () {
      if (!window.PagefindUI) return;
      new window.PagefindUI({
        element: "#pagefind-search",
        showImages: false,
        pageSize: 8,
        translations: {},
      });
    };
    document.head.appendChild(s);
  })();
</script>
