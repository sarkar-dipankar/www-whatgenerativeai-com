---
// Illustrative chart: hours released are not cash saved. Theme-aware via Tailwind fill/stroke classes.
interface Props { class?: string }
const { class: cls = "" } = Astro.props;
const txt = "fill-stone-600 dark:fill-stone-300";
---
<figure class={cls}>
  <svg viewBox="0 0 420 260" class="w-full h-auto" role="img" aria-labelledby="oc-title oc-desc">
    <title id="oc-title">Hours released are not cash saved</title>
    <desc id="oc-desc">Illustrative bars: effort before the change, effort after including review time, and how the released hours split into cash realised and capacity that is not cash.</desc>
    <g class="stroke-stone-300 dark:stroke-stone-700" stroke-width="1">
      <line x1="40" y1="210" x2="400" y2="210" />
      <line x1="40" y1="160" x2="400" y2="160" stroke-dasharray="3 4" />
      <line x1="40" y1="110" x2="400" y2="110" stroke-dasharray="3 4" />
      <line x1="40" y1="60" x2="400" y2="60" stroke-dasharray="3 4" />
    </g>
    <defs>
      <pattern id="oc-hatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <rect width="6" height="6" class="fill-stone-200 dark:fill-stone-700" />
        <line x1="0" y1="0" x2="0" y2="6" class="stroke-stone-400 dark:stroke-stone-500" stroke-width="2" />
      </pattern>
    </defs>
    <!-- Before -->
    <rect x="70" y="50" width="64" height="160" rx="6" class="fill-stone-400 dark:fill-stone-600" />
    <!-- After: effort + review -->
    <rect x="180" y="140" width="64" height="70" rx="6" class="fill-primary-600 dark:fill-primary-500" />
    <rect x="180" y="118" width="64" height="22" rx="4" class="fill-accent-400" />
    <!-- Released hours split -->
    <rect x="300" y="50" width="64" height="40" rx="6" class="fill-accent-500" />
    <rect x="300" y="90" width="64" height="28" fill="url(#oc-hatch)" />
    <path d="M250 50h40M250 118h40" class="stroke-stone-400 dark:stroke-stone-500" stroke-dasharray="2 3" />
    <g font-family="Inter, ui-sans-serif, system-ui, sans-serif" font-size="11" font-weight="500">
      <text x="102" y="230" text-anchor="middle" class={txt}>Before</text>
      <text x="212" y="230" text-anchor="middle" class={txt}>After</text>
      <text x="332" y="230" text-anchor="middle" class={txt}>Released</text>
      <text x="212" y="112" text-anchor="middle" font-size="10" class="fill-accent-700 dark:fill-accent-300">+ review</text>
      <text x="332" y="44" text-anchor="middle" font-size="10" class="fill-accent-700 dark:fill-accent-300">cash realised</text>
      <text x="332" y="134" text-anchor="middle" font-size="10" class={txt}>not cash</text>
      <text x="40" y="250" font-size="10" class="fill-stone-400">Illustrative — not client data</text>
    </g>
  </svg>
</figure>
