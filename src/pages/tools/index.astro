---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import PageHeader from "../../components/PageHeader.astro";
import CtaPanel from "../../components/CtaPanel.astro";
import { TOOLS } from "../../data/tools";
import { SITE_URL } from "../../data/site";

const steps = ["Score the workflow", "Work out the economics", "Write the brief"];
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}/` },
      { "@type": "ListItem", position: 2, name: "Tools", item: `${SITE_URL}/tools/` },
    ],
  },
];
---
<BaseLayout
  lang="en"
  title="Free AI decision tools: scorecard, ROI calculator, brief builder"
  description="Three free tools for business AI decisions: score a workflow, calculate honest economics and build a project brief. Results on screen, no sign-up."
  jsonLd={jsonLd}
  alternates={[{ lang: "en", path: "/tools/" }]}
>
  <Header lang="en" path="/tools/" />
  <PageHeader
    eyebrow="Decision tools"
    title="Useful answers before any sales conversation"
    lede="Each tool runs in your browser and shows the full result on screen. Copy it, download it or print it. Ask us to review it only if you want to."
    crumbs={[{ label: "Tools" }]}
  />
  <main id="main" class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-14">
    <ol class="grid gap-6 md:grid-cols-3">
      {TOOLS.map((tl, i) => (
        <li>
          <a href={`/tools/${tl.slug}/`} class="group flex h-full flex-col rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900 p-6 hover:border-primary-400 hover:shadow-lg transition">
            <p class="text-xs font-semibold uppercase tracking-widest text-accent-600 dark:text-accent-400">Step {i + 1} · {steps[i]}</p>
            <h2 class="mt-2 text-xl font-bold text-stone-900 dark:text-stone-50 group-hover:text-primary-700 dark:group-hover:text-primary-300">{tl.name}</h2>
            <p class="mt-2 text-sm text-stone-600 dark:text-stone-400 flex-1">{tl.short}</p>
            <p class="mt-4 text-xs text-stone-500">~{tl.minutes} min · Produces: {tl.produces}</p>
            <span class="mt-3 text-sm font-semibold text-primary-700 dark:text-primary-300">Open →</span>
          </a>
        </li>
      ))}
    </ol>

    <section class="mt-14 max-w-3xl text-stone-600 dark:text-stone-400 space-y-3 text-sm leading-relaxed">
      <h2 class="text-lg font-bold text-stone-900 dark:text-stone-50">Privacy</h2>
      <p>Your answers are stored only in your browser's local storage, so the tools can pass results to one another. Nothing is sent to us unless you press “Request expert review” and then submit the project brief form. There is no tracking in the tools.</p>
    </section>

    <div class="mt-14 max-w-4xl">
      <CtaPanel
        title="Not sure which workflow to score?"
        body="Start with the opportunity-selection guide. It explains how to collect candidates and compare them fairly."
        primary={{ label: "Where should we start with AI?", href: "/guides/where-to-start-with-ai/" }}
        secondary={{ label: "See buying situations", href: "/start/" }}
      />
    </div>
  </main>
  <Footer lang="en" />
</BaseLayout>
