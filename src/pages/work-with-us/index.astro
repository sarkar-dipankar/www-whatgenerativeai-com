---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import PageHeader from "../../components/PageHeader.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import OfferCard from "../../components/OfferCard.astro";
import CtaPanel from "../../components/CtaPanel.astro";
import Disclosure from "../../components/Disclosure.astro";
import { OFFERS, formatPrice } from "../../data/offers";
import { SITE_URL, DELIVERY_ENTITY } from "../../data/site";

const entry = OFFERS.filter((o) => o.entry);
const downstream = OFFERS.filter((o) => !o.entry);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "OfferCatalog",
    name: "AI adoption engagements",
    url: `${SITE_URL}/work-with-us/`,
    itemListElement: OFFERS.map((o) => ({
      "@type": "Offer",
      itemOffered: { "@type": "Service", name: o.name, description: o.short, url: `${SITE_URL}/work-with-us/${o.slug}/` },
      priceSpecification: { "@type": "PriceSpecification", minPrice: o.fromPriceGBP, priceCurrency: "GBP" },
      seller: { "@type": "Organization", name: DELIVERY_ENTITY.name, url: DELIVERY_ENTITY.url },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}/` },
      { "@type": "ListItem", position: 2, name: "Work with us", item: `${SITE_URL}/work-with-us/` },
    ],
  },
];

const principles = [
  { title: "One accountable counterparty", body: `${DELIVERY_ENTITY.name} contracts the engagement and manages any specialists involved. You deal with one party that owns the outcome.` },
  { title: "Acceptance agreed up front", body: "Every scope states what 'done' means and how it will be checked, before work starts." },
  { title: "No custom AI is a valid answer", body: "Assessments are allowed to recommend existing software, process changes, or stopping. Otherwise a diagnostic is just a sales pitch." },
  { title: "Disclosed referrals", body: "If your need is outside our capacity or competence, we say so. Any referral is disclosed, including any fee, and is not a managed delivery promise." },
  { title: "Your brief is portable", body: "Briefs, evaluation sets and findings are written so you can use them with any supplier." },
  { title: "Private by default", body: "Client material stays separate from the public playbooks. Evidence is published only with your written permission." },
];
---
<BaseLayout
  lang="en"
  title="Work with us — AI opportunity, adoption and pilot reviews"
  description="Fixed-scope AI engagements: opportunity sprints, team workflow activation, pilot readiness reviews, implementation and assurance. Prices from £2,500."
  jsonLd={jsonLd}
  alternates={[{ lang: "en", path: "/work-with-us/" }]}
>
  <Header lang="en" path="/work-with-us/" />
  <PageHeader
    eyebrow="Work with us"
    icon="briefcase"
    title="Help deciding what to do with AI — and getting it done"
    lede="The playbooks and tools are free. Payment buys organisation-specific judgement, facilitation, implementation and accountability, each against an agreed acceptance condition."
    crumbs={[{ label: "Work with us" }]}
  >
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/work-with-us/intake/" class="inline-flex items-center gap-2 rounded-lg bg-accent-500 px-5 py-3 text-stone-900 font-semibold hover:bg-accent-400 transition">Start a project brief →</a>
      <a href="/start/" class="inline-flex items-center gap-2 rounded-lg border border-white/20 bg-white/10 px-5 py-3 text-white font-semibold hover:bg-white/20 transition">Not sure? Start here</a>
    </div>
  </PageHeader>

  <main id="main">
    <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16">
      <SectionHeader eyebrow="Entry engagements" title="Start with a decision, not a build" subtitle="Each one is fixed in scope, ends in a decision you can defend, and doesn't commit you to anything further." />
      <div class="grid gap-5 lg:grid-cols-3">
        {entry.map((o) => <OfferCard offer={o} />)}
      </div>
    </section>

    <section class="bg-white dark:bg-stone-900 border-y border-stone-200 dark:border-stone-800">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16">
        <SectionHeader eyebrow="When justified" title="Implementation and ongoing assurance" subtitle="Downstream paths, not mandatory upsells. They're scoped from a brief and accepted against agreed checks." />
        <div class="grid gap-5 md:grid-cols-2 max-w-5xl mx-auto">
          {downstream.map((o) => <OfferCard offer={o} />)}
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16">
      <SectionHeader eyebrow="How we work" title="Principles that protect the buyer" />
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {principles.map((p) => (
          <div class="rounded-xl border border-stone-200 dark:border-stone-800 p-6">
            <h3 class="font-semibold text-stone-900 dark:text-stone-50">{p.title}</h3>
            <p class="mt-1 text-sm text-stone-600 dark:text-stone-400">{p.body}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 pb-16">
      <h2 class="text-2xl font-bold text-stone-900 dark:text-stone-50 mb-4">At a glance</h2>
      <div class="overflow-x-auto rounded-xl border border-stone-200 dark:border-stone-800">
        <table class="w-full text-sm">
          <thead class="bg-primary-50 dark:bg-stone-800 text-left text-primary-900 dark:text-primary-300">
            <tr><th class="px-4 py-3">Engagement</th><th class="px-4 py-3">For when…</th><th class="px-4 py-3">Typical duration</th><th class="px-4 py-3 whitespace-nowrap">Price</th></tr>
          </thead>
          <tbody>
            {OFFERS.map((o) => (
              <tr class="border-t border-stone-200 dark:border-stone-800">
                <td class="px-4 py-3 font-semibold"><a href={`/work-with-us/${o.slug}/`} class="text-primary-700 dark:text-primary-300 hover:underline">{o.name}</a></td>
                <td class="px-4 py-3 text-stone-600 dark:text-stone-400">“{o.situation}”</td>
                <td class="px-4 py-3 text-stone-600 dark:text-stone-400 whitespace-nowrap">{o.duration}</td>
                <td class="px-4 py-3 whitespace-nowrap">{formatPrice(o)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-3 text-xs text-stone-500">Prices exclude VAT and are starting points. Every engagement is scoped and priced in writing before work starts.</p>
    </section>

    <section class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 pb-16">
      <CtaPanel
        title="Tell us about one workflow"
        body="The project brief takes about five minutes. A person reads it and replies with whether there's a viable project and the smallest sensible next step."
        primary={{ label: "Start a project brief", href: "/work-with-us/intake/" }}
        secondary={{ label: "Score a workflow first", href: "/tools/workflow-scorecard/" }}
      />
      <Disclosure class="mt-6" />
    </section>
  </main>
  <Footer lang="en" />
</BaseLayout>
